#: includes/class-return-exchange-admin.php:677
#: includes/zorem-exchanges/class-exchange-common-functions.php:928
msgid ""
"<strong>Exchange Guidelines:</strong><ul><li>Securely package the item you "
"are returning for exchange to prevent damage during transit. Use the "
"original packaging if possible.</li><li>Use a reliable shipping service to "
"send the package back to us. We recommend a service that provides tracking "
"information. This helps ensure the package reaches us safely and allows you "
"to track its status.</li><li>After shipping your exchange package, please "
"notify us by replying to the initial email or contacting our support team "
"with the tracking number.</li><li>Upon receiving the exchanged items, we "
"will inspect them to ensure they meet our exchange policy criteria. If the "
"items are in good condition and meet the criteria, we will process the "
"exchange.</li><li>Once the exchange is approved, we will ship the "
"replacement item to you. You will receive a confirmation email with tracking "
"information once the new item is dispatched.</li><li>Exchanges will be "
"processed within 5-7 business days of receiving the returned items. The "
"shipping time for the new item may vary depending on your location.</li></ul>"
msgstr ""
"<strong>એક્સચેન્જ માર્ગદર્શિકા:</strong><ul><li>ટ્રાન્સપોર્ટ દરમિયાન નુકસાન "
"અટકાવવા માટે તમે જે વસ્તુ પરત કરી રહ્યા છો તેને સુરક્ષિત રીતે પેકેજ કરો. "
"શક્ય હોય તો મૂળ પેકેજિંગનો ઉપયોગ કરો.</li><li>પેકેજ અમને પાછું મોકલવા માટે "
"વિશ્વસનીય શિપિંગ સેવાનો ઉપયોગ કરો. અમે એવી સેવાની ભલામણ કરીએ છીએ જે ટ્રેકિંગ "
"માહિતી પ્રદાન કરે છે. આ ખાતરી કરવામાં મદદ કરે છે કે પેકેજ અમને સુરક્ષિત રીતે "
"પહોંચે છે અને તમને તેની સ્થિતિ ટ્રેક કરવાની મંજૂરી આપે છે.</li><li>તમારા "
"એક્સચેન્જ પેકેજને શિપિંગ કર્યા પછી, કૃપા કરીને પ્રારંભિક ઇમેઇલનો જવાબ આપીને "
"અથવા ટ્રેકિંગ નંબર સાથે અમારી સપોર્ટ ટીમનો સંપર્ક કરીને અમને સૂચિત કરો.</li>"
"<li>એક્સચેન્જ કરેલી વસ્તુઓ પ્રાપ્ત કર્યા પછી, અમે તેમની તપાસ કરીશું કે તેઓ "
"અમારા એક્સચેન્જ નીતિ માપદંડોને પૂર્ણ કરે છે. જો વસ્તુઓ સારી સ્થિતિમાં હોય "
"અને માપદંડોને પૂર્ણ કરે છે, તો અમે એક્સચેન્જની પ્રક્રિયા કરીશું.</li><li>"
"એક્સચેન્જ મંજૂર થયા પછી, અમે રિપ્લેસમેન્ટ આઇટમ તમને મોકલીશું. નવી વસ્તુ "
"મોકલ્યા પછી તમને ટ્રેકિંગ માહિતી સાથેનો પુષ્ટિકરણ ઇમેઇલ પ્રાપ્ત થશે.</li><li>"
"પાછલી વસ્તુઓ પ્રાપ્ત થયાના 5-7 કાર્યકારી દિવસોમાં એક્સચેન્જની પ્રક્રિયા "
"કરવામાં આવશે. નવી વસ્તુ માટે શિપિંગ સમય તમારા સ્થાનના આધારે બદલાઈ શકે છે."
"</li></ul>"

#: includes/class-return-exchange-admin.php:613
#: includes/zorem-returns/class-return-common-functions.php:833
#| msgid ""
#| "<strong>Return Guidelines:</strong><ul><li>Ensure all items being "
#| "returned are securely packaged to prevent damage during transit.</li><li>"
#| "Use a reliable shipping service to send the package back to us. We "
#| "recommend using a service that provides tracking information.</li><li>"
#| "Once your return package is shipped, please notify us by replying to this "
#| "email with the tracking number.</li><li>Upon receiving the returned items,"
#| " we will inspect them to ensure they meet our return policy criteria.</li>"
#| "<li>Refunds or store credits will be processed within 5-7 business days "
#| "of receiving the returned items.</li></ul>"
msgid ""
"<strong>Return Guidelines:</strong><ul><li>Ensure all items being returned "
"are securely packaged to prevent damage during transit.</li><li>Use a "
"reliable shipping service to send the package back to us. We recommend using "
"a service that provides tracking information.</li><li>Once your return "
"package is shipped, please notify us by replying to this email with the "
"tracking number.</li><li>Upon receiving the returned items, we will inspect "
"them to ensure they meet our return policy criteria.</li><li>Refunds or "
"store credits will be processed within 5–7 business days of receiving the "
"returned items.</li></ul>"
msgstr ""
"<strong>રીટર્ન માર્ગદર્શિકા:</strong><ul><li>રીટર્ન દરમિયાન નુકસાન અટકાવવા "
"માટે પરત કરવામાં આવતી બધી વસ્તુઓ સુરક્ષિત રીતે પેક કરવામાં આવે તેની ખાતરી "
"કરો.</li><li>પેકેજ અમને પાછું મોકલવા માટે વિશ્વસનીય શિપિંગ સેવાનો ઉપયોગ કરો. "
"અમે ટ્રેકિંગ માહિતી પ્રદાન કરતી સેવાનો ઉપયોગ કરવાની ભલામણ કરીએ છીએ.</li><li>"
"એકવાર તમારું રીટર્ન પેકેજ મોકલાઈ જાય, પછી કૃપા કરીને ટ્રેકિંગ નંબર સાથે આ "
"ઇમેઇલનો જવાબ આપીને અમને સૂચિત કરો.</li><li>રીટર્ન આઇટમ્સ પ્રાપ્ત થયા પછી, "
"અમે ખાતરી કરીશું કે તે અમારા રીટર્ન પોલિસી માપદંડોને પૂર્ણ કરે છે.</li><li>"
"રીટર્ન આઇટમ્સ પ્રાપ્ત થયાના 5-7 કાર્યકારી દિવસોમાં રિફંડ અથવા સ્ટોર "
"ક્રેડિટ્સ પર પ્રક્રિયા કરવામાં આવશે.</li></ul>"

