#~ "воспользуйтесь поддержкой автоматического возврата и обмена, чтобы ваш "
#~ "клиент мог мгновенно вернуть или обменять товар."

msgid "Email Address"
msgstr "Адрес электронной почты"

msgid "Order ID"
msgstr "ID заказа"

msgid "Find My Order"
msgstr "Найти мой заказ"

msgid "Return Portal"
msgstr "Портал возвратов"

msgid "Let's track your order first"
msgstr "Сначала давайте отследим ваш заказ"

msgid "This order number does not exist."
msgstr "Такой номер заказа не существует."

msgid "This email address does not match the order number."
msgstr "Этот адрес электронной почты не соответствует номеру заказа."

msgid "This order is not eligible for return and exchange."
msgstr "Этот заказ не подлежит возврату и обмену."

msgid "A return or exchange has already been requested for this order."
msgstr "Для этого заказа уже запрошен возврат или обмен."

msgid "Invalid file type. Allowed types: %s"
msgstr "Недопустимый тип файла. Разрешённые типы: %s"

msgid "File size exceeds the allowed limit (5 MB)"
msgstr "Размер файла превышает допустимый лимит (5 МБ)"
